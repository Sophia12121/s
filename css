:root {
    --bg: #0f172a;
    --card-bg: #1e293b;
    --primary: #38bdf8;
    --text: #f8fafc;
}

body {
    background-color: var(--bg);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    margin: 0;
    padding-bottom: 50px;
}

.container { width: 90%; max-width: 1100px; margin: 0 auto; text-align: center; }

header { padding: 4rem 0; background: linear-gradient(to bottom, #1e293b, #0f172a); }
h1 span { color: var(--primary); }

.movie-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-top: -2rem;
}

.movie-card {
    background: var(--card-bg);
    border-radius: 15px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.movie-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    border-color: var(--primary);
}

.movie-poster { height: 200px; background: #334155; display: flex; align-items: center; justify-content: center; font-size: 3rem; }

.movie-info { padding: 1.5rem; text-align: left; }
.movie-info h3 { margin: 0 0 10px 0; color: var(--primary); }
.rating { color: #fbbf24; font-weight: bold; }
